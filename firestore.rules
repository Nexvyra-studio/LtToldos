rules_version = '2';

// Regras do banco (Firestore) do sistema RDN Soldas | Toldos.
// Só quem fez login (usuário criado em Authentication) lê e grava,
// e cada documento precisa ter os campos certos.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehData(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- Financeiro: compras e pagamentos ----------
    match /lancamentos/{id} {
      function lancamentoValido(d) {
        return d.keys().hasAll(['descricao', 'valor', 'data', 'pago', 'dataPagamento', 'criadoEm'])
          && d.keys().hasOnly(['tipo', 'servicoId', 'descricao', 'valor', 'data', 'pago', 'dataPagamento', 'criadoEm', 'criadoPor'])
          && (!('tipo' in d) || d.tipo in ['despesa', 'receita'])
          && (!('servicoId' in d) || d.servicoId == null || d.servicoId is string)
          && d.descricao is string && d.descricao.size() <= 80
          && d.valor is number && d.valor > 0 && d.valor < 100000000
          && ehData(d.data)
          && d.pago is bool
          && (d.dataPagamento == null || ehData(d.dataPagamento))
          && d.criadoEm is number;
      }

      allow read, delete: if logado();
      allow create, update: if logado() && lancamentoValido(request.resource.data);
    }

    // ---------- Serviços: cálculos de toldo salvos ----------
    match /calculos/{id} {
      function calculoValido(d) {
        return d.keys().hasAll(['tipo', 'cliente', 'entrada', 'resultado', 'criadoEm'])
          && d.tipo in ['cortina', 'cortina-visor', 'casca', 'casca-bando', 'fixo-lateral']
          && d.cliente is string && d.cliente.size() <= 60
          && d.entrada is map
          && d.resultado is map
          && d.criadoEm is number
          && (!('valor' in d) || (d.valor is number && d.valor >= 0))
          && (!('status' in d) || d.status in ['aberto', 'finalizado'])
          && (!('finalizadoEm' in d) || d.finalizadoEm == null || ehData(d.finalizadoEm))
          && (!('lancamentoId' in d) || d.lancamentoId == null || d.lancamentoId is string)
          // vários toldos no mesmo serviço (até 40)
          && (!('itens' in d) || (d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 40));
      }

      allow read, delete: if logado();
      allow create, update: if logado() && calculoValido(request.resource.data);
    }

    // qualquer outra coleção fica bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
